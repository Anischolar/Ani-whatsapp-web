# ---- Required ----------------------------------------------------------------
# MongoDB connection string (local MongoDB, Atlas, etc.)
MONGODB_URI=mongodb://127.0.0.1:27017/whatsapp_bulk

# Random secret (32+ chars) used to sign admin sessions.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Admin login. Prefer ADMIN_PASSWORD_HASH (bcrypt, from `npm run hash-password -- "pass"`).
# Escape each "$" in the hash as "\$" inside .env files.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Plain-text fallback, only used when ADMIN_PASSWORD_HASH is empty. Avoid in production.
ADMIN_PASSWORD=

# ---- Optional ----------------------------------------------------------------
# Where uploads (images) and the WhatsApp session are stored on disk.
STORAGE_DIR=./storage
# Country used to interpret numbers without a country code (ISO 3166 alpha-2).
DEFAULT_COUNTRY=US
SESSION_HOURS=12
MAX_UPLOAD_MB=5
MAX_CSV_MB=5
MAX_CSV_ROWS=20000
# Set to false behind plain-HTTP (no TLS) in production; cookies are Secure by default in production.
COOKIE_SECURE=true

# WhatsApp client
WA_AUTO_START=true          # reconnect saved session on server start
WA_HEADLESS=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome   # use a system Chrome instead of the bundled one
WHATSAPP_MOCK=false         # true = fake client for local testing; nothing is really sent

# Sending
SEND_MIN_DELAY_SEC=8
SEND_MAX_DELAY_SEC=20
DAILY_SEND_LIMIT=1000       # max messages per rolling 24h across all campaigns (0 = unlimited)

# Consent / opt-out
OPT_OUT_KEYWORDS=STOP,UNSUBSCRIBE,STOPALL,OPTOUT,OPT OUT,CANCEL,END,QUIT
OPT_IN_KEYWORDS=START,SUBSCRIBE,UNSTOP
OPT_OUT_FOOTER=Reply STOP to unsubscribe.
# OPT_OUT_REPLY=You have been unsubscribed ...
# OPT_IN_REPLY=You are subscribed again ...
